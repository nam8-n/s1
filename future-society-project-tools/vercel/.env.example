# Vercel 프로젝트의 Settings > Environment Variables 에 같은 이름으로 넣으세요. 이 파일은 예시입니다.
ANTHROPIC_API_KEY=sk-ant-...
# 교수용 채점기 접속 코드 (필수). 길고 추측하기 어려운 문장으로 정하세요.
GRADER_PASSWORD=
# 학생용 도우미 접속 코드 (권장). 수업 시간에 학생에게만 알려 주세요.
STUDENT_ACCESS_CODE=
# 학생 코드 없이 누구나 쓰게 하려면 true (비권장: 링크를 아는 누구나 API 비용을 씁니다)
# ALLOW_PUBLIC_CHAT=true
# 선택: 모델 이름과 요청 한도(10분당, IP별)
# MODEL_QUICK=claude-haiku-5-5
# MODEL_DEFAULT=claude-sonnet-5-5
# MODEL_COMPLEX=claude-opus-5-5
# RATE_CHAT_MAX=30
# RATE_GRADE_MAX=60
